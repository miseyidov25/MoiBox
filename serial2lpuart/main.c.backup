 *****************************************************************************/
#include <MCXA153.h>
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#include "serial.h"
#include "lpuart2.h"
#include "hal.h"

// -----------------------------------------------------------------------------
// Local type definitions
// -----------------------------------------------------------------------------
#ifdef DEBUG
#define TARGETSTR "Debug"
#else
#define TARGETSTR "Release"
#endif

#define LED_GPIO           GPIO3
#define LED_RED_PIN        12U
#define LED_GREEN_PIN      13U
#define LED_BLUE_PIN       0U
#define LED_ACTIVE_LOW     0U
#define LED_INACTIVE_HIGH  1U

#define BUTTON_GPIO        GPIO3
#define BUTTON_PIN         29U
#define BUTTON_ACTIVE_LOW  true

#define IBEACON_MAJOR_H0_37 0x0AEAU
#define IBEACON_MINOR_H0_37 0x0037U
#define IBEACON_TARGET_ADDRESS "1906D7C750FD"
#define IBEACON_TARGET_ADDRESS_LEN 12U

#define IBEACON_FRAME_SIZE 25U
#define IBEACON_LINE_MAX 128U
#define MAX_BEACONS 10

// Puzzle beacon minor IDs
#define PUZZLE1_MINOR "0037"
#define PUZZLE1_SPECIAL_MAJOR "0B01"
#define PUZZLE1_SPECIAL_MINOR "0001"
#define PUZZLE2_MINOR "0032"
#define PUZZLE3_MINOR "0026"
#define PUZZLE4_MINOR "0029"
#define PUZZLE5_MINOR "0031"

// -----------------------------------------------------------------------------
// Local type definitions
// -----------------------------------------------------------------------------
typedef struct {
    char minor[9];
    char mac[13];
    int8_t rssi;
} beacon_t;

// -----------------------------------------------------------------------------
// Local function prototypes
// -----------------------------------------------------------------------------
static void board_gpio_init(void);
static void led_set(uint32_t pin, bool on);
static void led_set_color(bool red, bool green, bool blue);
static void led_all_off(void);
static void led_set_red(void);
static void led_set_yellow(void);
static void led_set_blue(bool on);
static void led_set_green(void);
static bool button_pressed(void);
static void ibeacon_process_byte(uint8_t data);
static void ibeacon_detected(int8_t tx_power);
static void led_set_distance_color(int8_t tx_power);
static void parse_at_disc_line(const char *line, uint32_t length);
static void puzzle_dispatch(const char *minor, int8_t rssi);
static void puzzle1_handler(int8_t rssi);
static void puzzle2_handler(int8_t rssi);
static void puzzle3_handler(int8_t rssi);
static void puzzle4_handler(int8_t rssi);
static void puzzle5_handler(int8_t rssi);

// -----------------------------------------------------------------------------
// Local variables
// -----------------------------------------------------------------------------
static uint8_t ibeacon_buffer[IBEACON_FRAME_SIZE];
static uint32_t ibeacon_count = 0U;
static bool ibeacon_seen = false;
static bool button_last_state = false;
static bool sw3_mode = false;
static int8_t last_tx_power = 0;
static char ibeacon_line_buffer[IBEACON_LINE_MAX];
static uint32_t ibeacon_line_count = 0U;
static int8_t last_rssi = 0;
static beacon_t beacons[MAX_BEACONS];
static int beacon_count = 0;
static bool puzzle1_active = false;
static bool puzzle2_active = false;
static bool puzzle3_active = false;
static bool puzzle4_active = false;
static bool puzzle5_active = false;
static int puzzle1_x = 0;
static int puzzle1_y = 0;
static int puzzle1_z = 0;
static int puzzle1_d = 0;
static int puzzle1_user_answer = 0;
static bool puzzle1_input_active = false;

const char hardware_connection[] =
    "Hardware connection:\r\n"
    "\r\n"
    "     MCU-Link                FRDM-MCXA153                  Device\r\n"
    "    +--------+    +----------------------------------+    +--------\r\n"
    "    |      RX|<---|LPUART0_TX/P0_3 < LPUART2_RX/P1_4 |<---| TXD\r\n"
    "<-->|USB   TX|--->|LPUART0_RX/P0_2 > LPUART2_TX/P1_5 |--->| RXD\r\n"
    "    |        |    |                              3V3 |----| VCC\r\n"
    "    |        |    |                              GND |----| GND\r\n"
    "    +--------+    +----------------------------------+    +--------\r\n";

// -----------------------------------------------------------------------------
// Main application
// -----------------------------------------------------------------------------
int main(void)
{

    add(2, 3); // Example usage of HAL function
    
    serial_init(115200);
    lpuart2_init(9600);
    board_gpio_init();

    printf("Serial data forwarder with iBeacon detection\r\n");
    printf("%s build %s %s\r\n", TARGETSTR, __DATE__, __TIME__);
    printf("\r\n");
    printf(hardware_connection);
    printf("\r\n");

    while (1)
    {
        if (serial_rxcnt() > 0)
        {
            uint8_t data = serial_getchar();
            lpuart2_putchar(data);
        }

        if (lpuart2_rxcnt() > 0)
        {
            uint8_t data = lpuart2_getchar();
            serial_putchar(data);
            ibeacon_process_byte(data);
            
            // Handle keypad input for Puzzle 1
            if (puzzle1_input_active && data >= '0' && data <= '9')
            {
                int user_digit = data - '0';
                puzzle1_user_answer = user_digit;
                printf("%d\r\n", user_digit);
                
                if (puzzle1_user_answer == puzzle1_x)
                {
                    printf("\r\n========== CORRECT! ==========\r\n");
                    printf("X = %d is correct!\r\n", puzzle1_x);
                    printf("Puzzle 1 Solved!\r\n");
                }
                else
                {
                    printf("\r\nWrong! Try again.\r\n");
                    printf("Your answer: ");
                }
                puzzle1_input_active = false;
            }
        }

        bool button_now = button_pressed();
        if (button_now && !button_last_state)
        {
            sw3_mode = true;
            led_set_blue(true);
            printf("SW3 pressed: LED set to blue\r\n");
        }
        else if (!button_now && button_last_state)
        {
            sw3_mode = false;
            if (ibeacon_seen)
            {
                led_set_distance_color(last_tx_power);
            }
            else
            {
                led_all_off();
            }
        }
        button_last_state = button_now;
    }
}

// -----------------------------------------------------------------------------
// Local function implementation
// -----------------------------------------------------------------------------
static void board_gpio_init(void)
{
    MRCC0->MRCC_GLB_CC1_SET = MRCC_MRCC_GLB_CC1_GPIO3(1);
    MRCC0->MRCC_GLB_CC1_SET = MRCC_MRCC_GLB_CC1_PORT3(1);
    MRCC0->MRCC_GLB_RST1_SET = MRCC_MRCC_GLB_RST1_GPIO3(1);
    MRCC0->MRCC_GLB_RST1_SET = MRCC_MRCC_GLB_RST1_PORT3(1);

    PORT3->PCR[LED_RED_PIN] = PORT_PCR_MUX(0);
    PORT3->PCR[LED_GREEN_PIN] = PORT_PCR_MUX(0);
    PORT3->PCR[LED_BLUE_PIN] = PORT_PCR_MUX(0);

    led_all_off();
    LED_GPIO->PDDR |= (1U << LED_RED_PIN) | (1U << LED_GREEN_PIN) | (1U << LED_BLUE_PIN);

    PORT3->PCR[BUTTON_PIN] = PORT_PCR_LK(1) |
                             PORT_PCR_MUX(1) |
                             PORT_PCR_PE(1) |
                             PORT_PCR_PS(1) |
                             PORT_PCR_IBE(1);
    BUTTON_GPIO->PDDR &= ~(1U << BUTTON_PIN);
}

static void led_set(uint32_t pin, bool on)
{
    LED_GPIO->PDR[pin] = on ? LED_ACTIVE_LOW : LED_INACTIVE_HIGH;
}

static void led_set_color(bool red, bool green, bool blue)
{
    led_all_off();
    if (red)
    {
        led_set(LED_RED_PIN, true);
    }
    if (green)
    {
        led_set(LED_GREEN_PIN, true);
    }
    if (blue)
    {
        led_set(LED_BLUE_PIN, true);
    }
}

static void led_all_off(void)
{
    led_set(LED_RED_PIN, false);
    led_set(LED_GREEN_PIN, false);
    led_set(LED_BLUE_PIN, false);
}

static void led_set_red(void)
{
    led_set_color(true, false, false);
}

static void led_set_yellow(void)
{
    led_set_color(true, true, false);
}

static void led_set_blue(bool on)
{
    if (on)
    {
        led_set_color(false, false, true);
    }
    else
    {
        led_all_off();
    }
}

static void led_set_green(void)
{
    led_set_color(false, true, false);
}

static void led_set_distance_color(int8_t tx_power)
{
    if (sw3_mode)
    {
        led_set_blue(true);
        return;
    }

    if (tx_power >= -55)
    {
        led_set_green();
    }
    else if (tx_power >= -70)
    {
        led_set_yellow();
    }
    else
    {
        led_set_red();
    }
}

static void parse_at_disc_line(const char *line, uint32_t length)
{
    const char prefix[] = "OK+DISC:";
    const uint32_t prefix_len = sizeof(prefix) - 1U;
    if (length <= prefix_len || strncmp(line, prefix, prefix_len) != 0)
    {
        return;
    }

    const char *field_start = line + prefix_len;
    const char *field_end;
    const char *major_minor_field = NULL;
    uint32_t major_minor_len = 0U;
    const char *mac_field = NULL;
    uint32_t mac_len = 0U;
    const char *rssi_field = NULL;
    uint32_t field_index = 0U;

    while (field_start < line + length && field_index < 5U)
    {
        field_end = memchr(field_start, ':', (line + length) - field_start);
        if (field_end == NULL)
        {
            field_end = line + length;
        }

        if (field_index == 2U)
        {
            major_minor_field = field_start;
            major_minor_len = (uint32_t)(field_end - field_start);
        }
        else if (field_index == 3U)
        {
            mac_field = field_start;
            mac_len = (uint32_t)(field_end - field_start);
        }
        else if (field_index == 4U)
        {
            rssi_field = field_start;
            break;
        }

        if (field_end >= line + length)
        {
            break;
        }

        field_start = field_end + 1U;
        field_index++;
    }

    // Check for special Puzzle 1 beacon (MAJOR 0B01)
    if (major_minor_field && major_minor_len >= 8 && strncmp(major_minor_field, PUZZLE1_SPECIAL_MAJOR, 4) == 0 &&
        mac_field && rssi_field)
    {
        char rssi_text[8];
        uint32_t text_len = (uint32_t)((line + length) - rssi_field);
        if (text_len >= sizeof(rssi_text))
        {
            return;
        }

        memcpy(rssi_text, rssi_field, text_len);
        rssi_text[text_len] = '\0';

        char *endptr = NULL;
        long rssi_value = strtol(rssi_text, &endptr, 10);
        if (endptr == rssi_text || *endptr != '\0')
        {
            return;
        }

        if (rssi_value < -128 || rssi_value > 127)
        {
            return;
        }

        int8_t rssi = (int8_t)rssi_value;
        puzzle1_handler(rssi);
        return;
    }

    if (major_minor_field && major_minor_len >= 8 && strncmp(major_minor_field, "0AEA", 4) == 0 &&
        mac_field && rssi_field)
    {
        char minor[5];
        memcpy(minor, major_minor_field + 4, 4);
        minor[4] = '\0';

        char rssi_text[8];
        uint32_t text_len = (uint32_t)((line + length) - rssi_field);
        if (text_len >= sizeof(rssi_text))
        {
            return;
        }

        memcpy(rssi_text, rssi_field, text_len);
        rssi_text[text_len] = '\0';

        char *endptr = NULL;
        long rssi_value = strtol(rssi_text, &endptr, 10);
        if (endptr == rssi_text || *endptr != '\0')
        {
            return;
        }

        if (rssi_value < -128 || rssi_value > 127)
        {
            return;
        }

        int8_t rssi = (int8_t)rssi_value;

        if (beacon_count < MAX_BEACONS)
        {
            memcpy(beacons[beacon_count].minor, minor, 5);
            memcpy(beacons[beacon_count].mac, mac_field, mac_len);
            beacons[beacon_count].mac[mac_len] = '\0';
            beacons[beacon_count].rssi = rssi;
            beacon_count++;
        }
    }
}

static bool button_pressed(void)
{
    return (BUTTON_GPIO->PDR[BUTTON_PIN] == 0U);
}

static void ibeacon_detected(int8_t tx_power)
{
    ibeacon_seen = true;
    last_tx_power = tx_power;
    last_rssi = tx_power;
    if (!sw3_mode)
    {
        led_set_distance_color(tx_power);
    }
}

static void ibeacon_process_byte(uint8_t data)
{
    if (ibeacon_count < IBEACON_FRAME_SIZE)
    {
        ibeacon_buffer[ibeacon_count++] = data;
    }
    else
    {
        memmove(ibeacon_buffer, ibeacon_buffer + 1, IBEACON_FRAME_SIZE - 1);
        ibeacon_buffer[IBEACON_FRAME_SIZE - 1] = data;
    }

    if (ibeacon_count >= IBEACON_FRAME_SIZE)
    {
        if (ibeacon_buffer[0] == 0x4CU && ibeacon_buffer[1] == 0x00U &&
            ibeacon_buffer[2] == 0x02U && ibeacon_buffer[3] == 0x15U)
        {
            uint16_t major = (uint16_t)((ibeacon_buffer[20] << 8) | ibeacon_buffer[21]);
            uint16_t minor = (uint16_t)((ibeacon_buffer[22] << 8) | ibeacon_buffer[23]);
            int8_t tx_power = (int8_t)ibeacon_buffer[24];
            if (major == IBEACON_MAJOR_H0_37 && minor == IBEACON_MINOR_H0_37)
            {
                ibeacon_detected(tx_power);
            }
        }
    }

    if (data == '\r' || data == '\n')
    {
        if (ibeacon_line_count > 0)
        {
            ibeacon_line_buffer[ibeacon_line_count] = '\0';
            parse_at_disc_line(ibeacon_line_buffer, ibeacon_line_count);
            if (strcmp(ibeacon_line_buffer, "OK+DISCE") == 0)
            {
                printf("\r\n");
                bool target_found = false;
                int8_t last_detected_rssi = 0;
                
                for (int i = 0; i < beacon_count; i++)
                {
                    if (strcmp(beacons[i].minor, "0037") == 0)
                    {
                        const char *range_label;
                        int8_t r = beacons[i].rssi;
                        if (r >= -55)
                        {
                            range_label = "close";
                        }
                        else if (r >= -70)
                        {
                            range_label = "medium";
                        }
                        else
                        {
                            range_label = "far";
                        }
                        printf("Beacon 0AEA%sC5, RSSI %d %s", beacons[i].minor, r, range_label);
                        puzzle_dispatch(beacons[i].minor, r);
                        target_found = true;
                        last_detected_rssi = r;
                        break;
                    }
                }
                if (!target_found)
                {
                    printf(\"PUZZLE 1 ACTIVATED - Waiting for beacon\");
                    puzzle1_active = true;
                    puzzle1_input_active = true;
                    
                    // Generate random numbers for the puzzle
                    puzzle1_x = (rand() % 10) + 1;\n                    puzzle1_y = (rand() % 10) + 1;\n                    puzzle1_z = puzzle1_x + puzzle1_y;\n                    puzzle1_d = puzzle1_y + puzzle1_y;\n                    puzzle1_user_answer = 0;\n                    \n                    printf(\"\\r\\n\");\n                    printf(\"========== PUZZLE 1 ==========\");\n                    printf(\"\\r\\n\");\n                    printf(\"Math Challenge!\\r\\n\");\n                    printf(\"%d + %d = %d\\r\\n\", puzzle1_x, puzzle1_y, puzzle1_z);\n                    printf(\"%d + %d = %d\\r\\n\", puzzle1_y, puzzle1_y, puzzle1_d);\n                    printf(\"\\r\\n\");\n                    printf(\"Find X using the keypad (press 0-9):\\r\\n\");\n                    printf(\"Your answer: \");\n                }
                for (int i = 0; i < beacon_count; i++)
                {
                    if (strcmp(beacons[i].minor, "0037") != 0)  // Skip target if already printed
                    {
                        const char *range_label;
                        int8_t r = beacons[i].rssi;
                        if (r >= -55)
                        {
                            range_label = "close";
                        }
                        else if (r >= -70)
                        {
                            range_label = "medium";
                        }
                        else
                        {
                            range_label = "far";
                        }
                        printf("  Beacon 0AEA%sC5 RSSI %d %s", beacons[i].minor, r, range_label);
                        puzzle_dispatch(beacons[i].minor, r);
                        if (!target_found)
                        {
                            last_detected_rssi = r;
                        }
                    }
                }
                printf("\r\n");
                
                // Update LED based on last detected 0AEA beacon
                if (beacon_count > 0 && !sw3_mode)
                {
                    led_set_distance_color(last_detected_rssi);
                }
                
                beacon_count = 0;
            }
            ibeacon_line_count = 0U;
        }
    }
    else if (ibeacon_line_count + 1 < IBEACON_LINE_MAX)
    {
        ibeacon_line_buffer[ibeacon_line_count++] = (char)data;
    }
}

// -----------------------------------------------------------------------------
// Puzzle dispatch and handler functions
// -----------------------------------------------------------------------------
static void puzzle_dispatch(const char *minor, int8_t rssi)
{
    if (strcmp(minor, PUZZLE1_MINOR) == 0)
    {
        puzzle1_handler(rssi);
    }
    else if (strcmp(minor, PUZZLE2_MINOR) == 0)
    {
        puzzle2_handler(rssi);
    }
    else if (strcmp(minor, PUZZLE3_MINOR) == 0)
    {
        puzzle3_handler(rssi);
    }
    else if (strcmp(minor, PUZZLE4_MINOR) == 0)
    {
        puzzle4_handler(rssi);
    }
    else if (strcmp(minor, PUZZLE5_MINOR) == 0)
    {
        puzzle5_handler(rssi);
    }
}

static void puzzle1_handler(int8_t rssi)
{
    puzzle1_active = true;
    puzzle1_input_active = true;
    
    // Generate random numbers for the puzzle
    // x + y = z
    // y + y = d
    // Solve for x
    puzzle1_x = (rand() % 10) + 1;      // x: 1-10
    puzzle1_y = (rand() % 10) + 1;      // y: 1-10
    puzzle1_z = puzzle1_x + puzzle1_y;  // z = x + y
    puzzle1_d = puzzle1_y + puzzle1_y;  // d = y + y
    puzzle1_user_answer = 0;
    
    printf("\r\n========== PUZZLE 1 ACTIVATED ==========");
    printf("\r\n");
    printf("Math Challenge!\r\n");
    printf("%d + %d = %d\r\n", puzzle1_x, puzzle1_y, puzzle1_z);
    printf("%d + %d = %d\r\n", puzzle1_y, puzzle1_y, puzzle1_d);
    printf("\r\n");
    printf("Find X using the keypad (press 0-9):\r\n");
    printf("Your answer: ");
}

static void puzzle2_handler(int8_t rssi)
{
    puzzle2_active = true;
    printf("[PUZZLE 2 ACTIVATED] RSSI: %d\r\n", rssi);
    // Add your Puzzle 2 logic here
}

static void puzzle3_handler(int8_t rssi)
{
    puzzle3_active = true;
    printf("[PUZZLE 3 ACTIVATED] RSSI: %d\r\n", rssi);
    // Add your Puzzle 3 logic here
}

static void puzzle4_handler(int8_t rssi)
{
    puzzle4_active = true;
    printf("[PUZZLE 4 ACTIVATED] RSSI: %d\r\n", rssi);
    // Add your Puzzle 4 logic here
}

static void puzzle5_handler(int8_t rssi)
{
    puzzle5_active = true;
    printf("[PUZZLE 5 ACTIVATED] RSSI: %d\r\n", rssi);
    // Add your Puzzle 5 logic here
}
